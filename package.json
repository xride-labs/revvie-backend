{
  "name": "revvie-backend",
  "version": "1.0.0",
  "description": "Revvie Backend API with Express, Prisma, and Better Auth",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "bun run prisma:deploy && tsx watch src/server.ts",
    "build": "bun run prisma:generate && tsc",
    "start": "bun run node dist/src/server.js",
    "start:with-db": "bun run prisma:deploy && bun run start",
    "deploy:render": "bun run prisma:deploy && bun run db:seed:prod",
    "build:render": "bun run prisma:deploy && bun run build",
    "prisma:generate": "bunx prisma generate",
    "prisma:migrate": "bunx prisma migrate dev",
    "prisma:deploy": "bunx prisma migrate deploy",
    "prisma:studio": "bunx prisma studio",
    "prisma:reset": "bunx prisma migrate reset --force",
    "prisma:status": "bunx prisma migrate status",
    "prisma:validate": "bunx prisma validate",
    "prisma:format": "bunx prisma format",
    "db:push": "bunx prisma db push",
    "db:pull": "bunx prisma db pull",
    "db:seed": "tsx prisma/seed.ts",
    "seed:bikes": "tsx src/scripts/seed-bikes.ts",
    "db:reset": "bunx prisma migrate reset --force && bun run db:seed",
    "db:seed:prod": "NODE_ENV=production node dist/prisma/seed.js",
    "postinstall": "bun run prisma:generate",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:routes": "vitest run src/routes",
    "test:smoke": "vitest run src/http.contract.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "better-auth"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1042.0",
    "@better-auth/passkey": "^1.7.2",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.10.0",
    "@sentry/node": "^10.51.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "bcryptjs": "^2.4.3",
    "better-auth": "^1.7.2",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.4.1",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.0.0",
    "node-cron": "^4.2.1",
    "pg": "^8.18.0",
    "socket.io": "^4.8.3",
    "standardwebhooks": "^1.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/node": "^20.19.39",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitest/coverage-v8": "^4.1.8",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "prisma": "7.10.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.1.1",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.2",
    "vitest": "^4.1.8"
  }
}
